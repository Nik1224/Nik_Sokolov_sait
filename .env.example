# --- Приём заявок -----------------------------------------------------------
# Куда приходят заявки с формы. Адрес нигде на сайте не публикуется.
CONTACT_RECIPIENT=
# Ключ сервиса отправки писем (https://resend.com → API Keys). Начинается с re_
RESEND_API_KEY=
# От чьего имени уходит письмо. Пока свой домен не подтверждён в Resend,
# оставьте значение по умолчанию — письма будут приходить на CONTACT_RECIPIENT.
CONTACT_SENDER=onboarding@resend.dev
# CONTACT_DRY_RUN=1 — провести заявку по всему пути, но письмо не отправлять.
# Используется автотестами; в рабочем окружении оставлять пустым.
CONTACT_DRY_RUN=

# --- CMS --------------------------------------------------------------------
# Заполняется после создания проекта на sanity.io.
# Пока переменные пусты, сайт работает на фикстурах content/seed.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Токен только для чтения черновиков в режиме предпросмотра. Никогда не коммитить.
SANITY_API_READ_TOKEN=
# Секрет для входа в режим предпросмотра: /api/preview?secret=...
SANITY_PREVIEW_SECRET=

# --- Общее ------------------------------------------------------------------
# Канонический домен. Влияет на canonical, hreflang, sitemap и OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
