# --- CMS --------------------------------------------------------------------
# Заполняется после создания проекта на sanity.io.
# Пока переменные пусты, сайт работает на фикстурах content/seed.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Токен только для чтения черновиков в режиме предпросмотра. Никогда не коммитить.
SANITY_API_READ_TOKEN=
# Секрет для входа в режим предпросмотра: /api/preview?secret=...
SANITY_PREVIEW_SECRET=

# --- Kinescope ----------------------------------------------------------------
# Только для выгрузки каталога роликов: scripts/kinescope-catalog.mjs.
# Выпускается в кабинете: настройки рабочей зоны → API-токены. Сайту не нужен.
KINESCOPE_API_TOKEN=

# --- Общее ------------------------------------------------------------------
# Канонический домен. Влияет на canonical, hreflang, sitemap и OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
